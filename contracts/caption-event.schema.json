{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "livelearn/contracts/caption-event.schema.json",
  "title": "CaptionEvent",
  "description": "Application-level caption event shared by the macOS and Windows reducers. Provider adapters translate vendor messages into this shape; the reducer never sees vendor objects. Times are session-relative monotonic nanoseconds of the source audio, never network arrival time.",
  "type": "object",
  "required": ["schemaVersion", "type", "sessionID", "laneID", "captureEpoch", "providerEpoch", "eventID"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "type": {
      "type": "string",
      "enum": ["source.replace", "source.final", "source.correction", "translation.replace", "translation.final", "lane.gap", "lane.state"]
    },
    "sessionID": { "type": "string" },
    "laneID": { "type": "string", "description": "Physical source lane, e.g. \"remote\" (app/system) or \"mic\"." },
    "captureEpoch": { "type": "integer", "minimum": 0, "description": "Capture clock/device continuity segment of the lane." },
    "providerEpoch": { "type": "integer", "minimum": 0, "description": "Provider connection generation. Events from an older epoch than the lane's active one are dropped." },
    "eventID": { "type": "string", "description": "Provider-unique id used for idempotency. Never derived from text." },
    "segmentID": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "startNs": { "type": "integer", "minimum": 0 },
    "endNs": { "type": "integer", "minimum": 0 },
    "text": { "type": "string" },
    "language": { "type": "string" },
    "isFinal": { "type": "boolean" },
    "vocabularyCandidates": {
      "type": "array", "maxItems": 12,
      "description": "Local, unconfirmed hypotheses for a final source revision. Never instructions to replace text. Offsets count Unicode grapheme clusters.",
      "items": {
        "type": "object",
        "required": ["start", "length", "original", "replacement", "reason"],
        "properties": {
          "start": { "type": "integer", "minimum": 0 },
          "length": { "type": "integer", "minimum": 1 },
          "original": { "type": "string", "minLength": 1 },
          "replacement": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "enum": ["similarSpelling", "samePronunciation"] }
        }
      }
    },
    "timingQuality": { "type": "string", "enum": ["word", "segment", "estimated", "unknown"] },
    "translationID": { "type": "string" },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segmentID", "revision"],
        "properties": {
          "segmentID": { "type": "string" },
          "revision": { "type": "integer", "minimum": 1 }
        }
      },
      "description": "Source segments and revisions a translation was produced from. Several refs mean one translation covers a group; the first ref owns it."
    },
    "gapReason": { "type": "string", "enum": ["queueOverflow", "deviceChange", "sourceRestart", "permissionLost", "paused", "network", "captureStall"] },
    "laneState": { "type": "string", "enum": ["running", "paused", "reconnecting", "stopped"] }
  },
  "allOf": [
    { "if": { "properties": { "type": { "enum": ["source.replace", "source.final", "source.correction"] } } },
      "then": { "required": ["segmentID", "revision", "text"] } },
    { "if": { "properties": { "type": { "enum": ["translation.replace", "translation.final"] } } },
      "then": { "required": ["sourceRefs", "text"] } },
    { "if": { "properties": { "type": { "const": "lane.gap" } } },
      "then": { "required": ["startNs", "endNs", "gapReason"] } },
    { "if": { "properties": { "type": { "const": "lane.state" } } },
      "then": { "required": ["laneState"] } }
  ]
}
